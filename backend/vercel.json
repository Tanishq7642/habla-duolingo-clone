{
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/dev/cron/daily-reset",
      "schedule": "0 0 * * *"
    }
  ]
}
